# StretchMetal quoting tool — environment variables
# Copy this file to .env.local for local dev, and add the same vars in
# Vercel → Project Settings → Environment Variables for production.
#
# REQUIRED for the app to work (auth, database, storage):
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# Everything else is optional — the build succeeds with none of them set.

# Public URL of the app — absolute links in emails and the PDF footer.
# [CONFIRM] domain
NEXT_PUBLIC_SITE_URL=https://quote.stretchmetal.pl

# Supabase project (Project Settings → API). Local dev: `supabase start`
# prints these (URL http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for storage signed URLs, re-pricing, audit log and
# admin actions after the user's role has been checked. NEVER expose it
# with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Default EUR→PLN exchange rate used when a new PLN quote is created.
# The rate actually used is stored on every quote. [CONFIRM] default rate
EXCHANGE_RATE_EUR_PLN_DEFAULT=4.30

# Optional — Claude API key for the PDF pre-fill (bends, angles, threads,
# finish, quantity, material, thickness read from the customer's drawing).
# Without it the tool shows the extracted PDF text only; nothing else changes.
ANTHROPIC_API_KEY=

# Optional — Microsoft Graph, sends quote PDFs to customers from Microsoft 365.
# Setup: register an app in Microsoft Entra, grant Mail.Send (Application)
# permission, then restrict it with an Exchange Online Application Access
# Policy so a leaked secret can only send from this one mailbox.
# Without the four MS_GRAPH_* vars the "Send" action offers download only.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_ADDRESS=
# Address shown as sender / reply-to on quote emails. [CONFIRM] address
QUOTE_FROM_ADDRESS=quotes@stretchmetal.pl
